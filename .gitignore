# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# Local AI/editor state and credentials
/.openai/
/.codex/
/.cursor/
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json

# Cloudflare local state and secrets
/.dev.vars
/.dev.vars.*
/.wrangler/

# OS and temporary files
Thumbs.db
*.swp
*.swo
*.tmp
*.bak
